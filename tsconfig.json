{
    "compilerOptions": {
        "target": "es2019",
        "module": "ESNext",
        "jsx": "react",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        // webpack で bundle するブラウザアプリなので，Node.js の実行時規則
        // (node16 など) ではなく bundler 向けの import 解決規則を使う。
        "moduleResolution": "bundler"
    },
    // ローカル作業資料や生成物を型検査対象に含めない。
    "include": ["src/**/*"],
    "exclude": [
      "node_modules"
    ]
}
